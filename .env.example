# Local demo only. Real sending is deliberately not implemented in this stage.
HOST=127.0.0.1
PORT=8080
DATABASE=data/assistant.sqlite3
# Set a random password of at least 16 characters; otherwise generated at startup.
ADMIN_PASSWORD=
MANAGER_PASSWORD=
REVIEWER_PASSWORD=
RETENTION_DAYS=180
# Image recognition, audio, calendar and notifications are not implemented.
APP_MODE=demo
# Optional: enable authenticated webhook ingestion after configuring secrets.
WEBHOOKS_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=
